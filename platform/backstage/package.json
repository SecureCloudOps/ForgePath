{
  "name": "forgepath-backstage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.22.2"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "backstage-cli repo start",
    "build": "backstage-cli repo build --all",
    "build:backend": "yarn workspace backend build",
    "lint": "backstage-cli repo lint",
    "test": "backstage-cli repo test",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.4",
    "@backstage/cli-defaults": "0.1.4",
    "@jest/environment-jsdom-abstract": "30.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/webpack-env": "1.18.8",
    "jest": "30.2.0",
    "jsdom": "27.1.0",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  }
}
